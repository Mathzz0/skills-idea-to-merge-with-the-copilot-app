---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="bookmark-hint"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="bookmark-hint" class="hint">Paste a URL with or without <code>https://</code> to generate its short <code>mona-</code> slug.</p>
<p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import {
    formatBookmark,
    parseStoredBookmarks,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks';

  const storageKey = 'mona-bookmarks';
  const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');

  let bookmarks: Bookmark[] = [];

  function showStatus(message: string) {
    if (status) status.textContent = message;
  }

  function persist(nextBookmarks: Bookmark[]): boolean {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      bookmarks = nextBookmarks;
      return true;
    } catch {
      showStatus('Bookmarks could not be saved in this browser.');
      return false;
    }
  }

  function createUniqueSlug(): string | null {
    for (let attempt = 0; attempt < 20; attempt += 1) {
      const bytes = new Uint8Array(8);
      try {
        window.crypto.getRandomValues(bytes);
      } catch {
        return null;
      }
      const slug = `mona-${Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
      if (!bookmarks.some((bookmark) => bookmark.slug === slug)) return slug;
    }
    return null;
  }

  function render() {
    if (!(list instanceof HTMLUListElement) || !(emptyState instanceof HTMLElement) || !(listHeader instanceof HTMLElement)) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = normalizeUrl(bookmark.url)!;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const formatted = document.createElement('span');
      formatted.className = 'formatted-bookmark';
      formatted.append(link, document.createTextNode(' :: '));

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      formatted.append(slug);

      item.append(formatted);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(urlInput instanceof HTMLInputElement)) return;

    const originalUrl = urlInput.value.trim();
    const normalizedUrl = normalizeUrl(originalUrl);
    if (!normalizedUrl) {
      showStatus('Enter a valid http or https URL.');
      urlInput.focus();
      return;
    }

    const slug = createUniqueSlug();
    if (!slug) {
      showStatus('A unique slug could not be generated. Please try again.');
      return;
    }

    if (persist([...bookmarks, { url: originalUrl, slug }])) {
      urlInput.value = '';
      showStatus(`Saved ${formatBookmark(originalUrl, slug)}.`);
      render();
      urlInput.focus();
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (bookmarks.length && window.confirm('Clear all saved bookmarks?') && persist([])) {
      showStatus('All bookmarks were cleared.');
      render();
    }
  });

  try {
    bookmarks = parseStoredBookmarks(window.localStorage.getItem(storageKey));
  } catch {
    showStatus('Bookmarks could not be read from this browser.');
  }
  render();
</script>

<style>
  .status {
    min-height: 1.5em;
    margin: -0.75rem 0 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .bookmark .formatted-bookmark {
    display: inline-flex;
    align-items: baseline;
    flex: 1 1 12rem;
    flex-wrap: wrap;
    overflow-wrap: anywhere;
  }

  .bookmark .url {
    flex: initial;
  }

  .bookmark .slug {
    white-space: nowrap;
  }

</style>
